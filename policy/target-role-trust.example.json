{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustFictionalAuditCallerOnly",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::000000000000:role/MockAuditCaller"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "mock-delegation-id"
        }
      }
    }
  ]
}
